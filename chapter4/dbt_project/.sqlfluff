# dbt v2 に内蔵の `dbt lint` / `dbt format` が読む設定。
# sqlfluff と互換のフォーマットなので、v1 版の .sqlfluff をほぼそのまま流用できる。
# ただし sqlfluff-templater-dbt 用の [sqlfluff:templater:dbt] セクション（project_dir など）は
# 不要になったため削除し、dialect は postgres から duckdb に変更している。
# templater = dbt は残す（v2 が対応するのは dbt テンプレータのみで、省略すると jinja 扱いで警告になる）。
[sqlfluff]
templater = dbt
dialect = duckdb
sql_file_exts = .sql
max_line_length = 100
exclude_rules = LT05, L036

[sqlfluff:indentation]
indented_joins = False
indented_using_on = True
template_blocks_indent = False
tab_space_size = 4

[sqlfluff:rules]
allow_scalar = True
single_table_references = consistent

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower
